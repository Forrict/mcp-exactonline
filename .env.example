# Exact Online OAuth2 app credentials (register at https://apps.exactonline.com)
EXACT_CLIENT_ID=your-client-id
EXACT_CLIENT_SECRET=your-client-secret

# Region determines the API base URL.
# One of: nl | be | uk | de | fr | es | us  (default: nl)
EXACT_REGION=nl

# Optional: pin a specific administration/division.
# If omitted, the server uses the CurrentDivision from /current/Me.
EXACT_DIVISION=

# OAuth2 redirect URI. The port here is used by `npm run auth`'s local server.
# Must exactly match the redirect URI configured on your Exact Online app.
EXACT_REDIRECT_URI=http://localhost:8123/callback

# Where to persist tokens (access_token, refresh_token, expires_at).
EXACT_TOKEN_STORE=~/.mcp-exactonline/tokens.json

# Optional bootstrap: if the token store file does not exist yet but this is
# set, the server/CLI will seed the store from this refresh token on first use.
# NOTE: Exact refresh tokens are single-use, so this is only a seed value.
EXACT_REFRESH_TOKEN=
