{
  "name": "mcp-exactonline",
  "version": "0.1.0",
  "description": "MCP server for Exact Online (cloud accounting)",
  "license": "MIT",
  "author": "Forrict",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forrict/mcp-exactonline.git"
  },
  "homepage": "https://github.com/Forrict/mcp-exactonline#readme",
  "bugs": {
    "url": "https://github.com/Forrict/mcp-exactonline/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "exact-online",
    "accounting",
    "claude",
    "aws-lambda"
  ],
  "type": "module",
  "bin": {
    "mcp-exactonline": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "node dist/auth/login.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p infra && tsc -p tests",
    "deploy": "cdk deploy",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
