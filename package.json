{
  "name": "mcp-exactonline",
  "version": "0.1.0",
  "description": "MCP server for Exact Online (cloud accounting)",
  "type": "module",
  "bin": {
    "mcp-exactonline": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "node dist/auth/login.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p infra",
    "deploy": "cdk deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1139.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
